# Server
PORT=8080
LOG_LEVEL=info
# Postgres connection string (production/staging). Tests use in-process PGlite and ignore this.
DATABASE_URL=postgres://rewards:rewards@localhost:5432/rewards
# Shopify. Apps are created in the Dev Dashboard (admin-created custom apps can no longer be created).
SHOPIFY_SHOP_DOMAIN=betterrhodes.myshopify.com
SHOPIFY_CLIENT_ID=xxx                    # Dev Dashboard > your app > App settings > Credentials
SHOPIFY_CLIENT_SECRET=shpss_xxx          # same card; also signs app-proxy requests and app-created webhooks
SHOPIFY_WEBHOOK_SECRET=xxx               # only if webhooks are created in Settings > Notifications (store-level); otherwise omit
# Legacy: an existing admin-created custom app token still works instead of client credentials.
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2026-01
# Klaviyo (emission is OFF until KLAVIYO_EMIT_ENABLED=true)
KLAVIYO_PRIVATE_API_KEY=pk_xxx
KLAVIYO_EMIT_ENABLED=false
# Admin API bearer token (rotate regularly)
ADMIN_API_TOKEN=change-me
# Program rules file
RULES_PATH=./config/rules.json
# Public base URL for referral landing links, e.g. https://www.betterrhodes.com
PUBLIC_BASE_URL=https://www.betterrhodes.com
