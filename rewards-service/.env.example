# Server
PORT=8080
LOG_LEVEL=info
# Postgres connection string (production/staging). Tests use in-process PGlite and ignore this.
DATABASE_URL=postgres://rewards:rewards@localhost:5432/rewards
# Shopify custom app
SHOPIFY_SHOP_DOMAIN=better-rhodes.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_SECRET=shpss_xxx            # used to verify webhook HMAC and app-proxy signatures
SHOPIFY_API_VERSION=2026-01
# Klaviyo (emission is OFF until KLAVIYO_EMIT_ENABLED=true)
KLAVIYO_PRIVATE_API_KEY=pk_xxx
KLAVIYO_EMIT_ENABLED=false
# Admin API bearer token (rotate regularly)
ADMIN_API_TOKEN=change-me
# Program rules file
RULES_PATH=./config/rules.json
# Public base URL for referral landing links, e.g. https://www.betterrhodes.com
PUBLIC_BASE_URL=https://www.betterrhodes.com
