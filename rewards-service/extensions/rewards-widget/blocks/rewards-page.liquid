{%- comment -%} App block: replaces Yotpo widget 123052 on /pages/loyalty-rewards {%- endcomment -%}
{{ 'rewards-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'rewards-widget.js' | asset_url }}" defer></script>
<div data-br-rewards="rewards-page"
     data-proxy="{{ block.settings.proxy_path | default: '/apps/rewards' }}"
     data-heading="{{ block.settings.heading | escape }}"
     data-logged-in="{% if customer %}true{% else %}false{% endif %}"
     data-login-url="{{ routes.account_login_url }}"
     data-register-url="{{ routes.account_register_url }}"
     data-refer-url="/pages/loyalty-refer"
     style="--brw-primary: {{ block.settings.primary_color }}; --brw-text-on-primary: {{ block.settings.text_on_primary }}; --brw-radius: {{ block.settings.radius }}px;"></div>
{% schema %}
{
  "name": "t:rewards_page.name",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Better Rhodes Rewards" },
    { "type": "color", "id": "primary_color", "label": "Primary colour", "default": "#ed6921" },
    { "type": "color", "id": "text_on_primary", "label": "Text on primary", "default": "#ffffff" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "default": 12 },
    { "type": "text", "id": "proxy_path", "label": "App proxy path", "default": "/apps/rewards" }
  ]
}
{% endschema %}
